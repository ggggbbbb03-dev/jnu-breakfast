{
  "regions": [
    "icn1"
  ],
  "functions": {
    "api/dorm1.js": {
      "maxDuration": 30
    },
    "api/dorm1-meals.js": {
      "maxDuration": 30
    }
  },
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
